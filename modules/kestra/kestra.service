[Unit]
Description=Kestra Event-Driven Declarative Orchestrator
Documentation=https://kestra.io/docs/
After=network-online.target

[Service]
Type=simple
ExecStart=/bin/sh /opt/kestra/kestra server local -c /opt/kestra/config.yaml
User=osbdet
Group=osbdet
RestartSec=5
Restart=always

[Install]
WantedBy=multi-user.target
